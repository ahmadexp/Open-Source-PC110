; ===== PS2.EXE setting-layer disassembly (ndisasm -b16, file offsets) =====
; Generic SET helper for vendor function 83 (get-modify-write bitfield):
;   entry AL=value, CX=(CH=mask, CL=shift); does GET 8300, clears mask, ORs (value<<shift), SET 8301
00004F97  86E5              xchg ah,ch
00004F99  D2E0              shl al,cl
00004F9B  22C4              and al,ah
00004F9D  F6D4              not ah
00004F9F  50                push ax
00004FA0  B88053            mov ax,0x5380
00004FA3  BB0083            mov bx,0x8300
00004FA6  CD15              int byte 0x15
00004FA8  58                pop ax
00004FA9  22CC              and cl,ah
00004FAB  0AC8              or cl,al
00004FAD  B88053            mov ax,0x5380
00004FB0  BB0183            mov bx,0x8301
00004FB3  CD15              int byte 0x15
00004FB5  C3                ret

