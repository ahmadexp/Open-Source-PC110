00004FDA  58                pop ax
00004FDB  22CC              and cl,ah
00004FDD  0AC8              or cl,al
00004FDF  B88053            mov ax,0x5380
00004FE2  BB0188            mov bx,0x8801
00004FE5  CD15              int byte 0x15
00004FE7  C3                ret

