   932                                                  ; The device/head register is written FIRST and allowed to
   933                                                  ; settle, because its meaning changes (0xA0 CHS -> 0xE0 LBA).
   934                                                  ; This is the one bit the stock BIOS never sets: F000:D430
   935                                                  ; does `or al,0xA0`, i.e. CHS mode forever.
   936 000006F1 BAF601                                  mov     dx, 0x1F6
   937 000006F4 26A04300                                mov     al, [es:V_LBA+3]
   938 000006F8 240F                                    and     al, 0x0F
