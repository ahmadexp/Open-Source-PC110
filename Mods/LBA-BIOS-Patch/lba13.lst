     1                                  ; ============================================================================
     2                                  ;  lba13.asm -- IBM PC110 BIOS: LBA / EDD (INT 13h extensions) patch payload
     3                                  ; ----------------------------------------------------------------------------
     4                                  ;  Target   : IBM PC110 (2431), 486SX-33, Intel 28F002BXT BIOS flash
     5                                  ;  Stock ROM: E28F002BXT@TSOP40.BIN, 262144 B, sha1 ffadd0d7c0ec619a3cd34c1d030299e1a9da1c58
     6                                  ;  Runs at  : F000:0080  (file offset 0x30080) -- inside the 7808-byte 0xCC hole
     7                                  ;             0x30080..0x31EFF, which lies inside the flasher's safe window
     8                                  ;             0x20000..0x37FFF (PCPATCH.ASM erases/programs exactly that range).
     9                                  ;  Hook     : F000:52BD  (file 0x352BD), the end-of-POST `int 19h`, replaced by
    10                                  ;             a 3-byte near JMP to F000:0080. We re-emit `int 19h` ourselves.
    11                                  ;
    12                                  ;  Assemble : nasm -f bin lba13.asm -o lba13.bin
    13                                  ;             (the builder make_lba_patch.py does this and splices the result)
    14                                  ;
    15                                  ; ----------------------------------------------------------------------------
    16                                  ;  WHAT THIS ADDS
    17                                  ;    * INT 13h AH=41h  EDD installation check          (reports EDD 1.1)
    18                                  ;    * INT 13h AH=42h  extended read   (LBA28, 0x1F0 task file, PIO)
    19                                  ;    * INT 13h AH=43h  extended write  (LBA28, 0x1F0 task file, PIO)
    20                                  ;    * INT 13h AH=48h  extended get drive parameters (+ DPTE)
    21                                  ;    * optional 1024/255/63 CHS translation for AH=02/03/04/08/15 when, and
    22                                  ;      ONLY when, the stock BIOS geometry cannot already reach the whole card.
    23                                  ;
    24                                  ;  WHAT IT DOES NOT DO
    25                                  ;    * No LBA48. LBA28 reaches 2^28 sectors = 128 GiB; a larger card is
    26                                  ;      clamped to 128 GiB-1 and the tail is silently unreachable.
    27                                  ;    * No ATAPI, no slave device (0x1F6=0xB0), no DMA, no multi-sector mode.
    28                                  ;    * Real-mode CHS is still capped at 1024*255*63*512 = 8.4 GB. That is an
    29                                  ;      encoding limit of the INT 13h register fields, not a translation choice.
    30                                  ;
    31                                  ; ----------------------------------------------------------------------------
    32                                  ;  DESIGN NOTES THAT DIFFER FROM THE ORIGINAL DESIGN DOC
    33                                  ;  (each one is a direct consequence of a verification verdict; see README.md)
    34                                  ;
    35                                  ;  [V1] The hook at F000:52BD runs BEFORE the PARAM1 code at F000:8067 that
    36                                  ;       installs F000:BAFE, because 8067 lives inside the INT 19h bootstrap
    37                                  ;       (F000:E6F2 -> F000:7DE4 -> ...), i.e. downstream of our own `int 19h`.
    38                                  ;       So we are installed first and BAFE may end up layered ON TOP of us.
    39                                  ;       => We must NOT replicate BAFE's DL remap. Proof it is unnecessary:
    40                                  ;          F000:8043 `mov al,0x80 / cmp al,[es:0xEC] / jz 0x806B` skips the
    41                                  ;          BAFE install entirely when EBDA:00EC == 0x80, and with [EC]==0x80
    42                                  ;          BAFE's rotation is the identity. Therefore:
    43                                  ;            - BAFE not installed  => EBDA:00EC == 0x80 => DL is already physical
    44                                  ;            - BAFE installed      => BAFE already converted DL to physical
    45                                  ;          Either way the DL we see is the physical drive number. We compare it
    46                                  ;          straight against V_OURDL. (The original design's own remap would have
    47                                  ;          double-remapped in the second case and serviced the wrong device.)
    48                                  ;
    49                                  ;  [V2] F000:BAFE is a transparent pass-through, not a filter; the AH>=0x21
    50                                  ;       clamp lives in the unrelated module at F000:BB78. But no handler in the
    51                                  ;       whole uncompressed ROM implements AH=41/42/43/48 (verified: no
    52                                  ;       `80 FC 42/43/48`, no `81 FB AA 55` anywhere in 0x20000-0x3FFFF), and all
    53                                  ;       three INT 13h dispatchers reject AH >= 0x26. So EDD must be ours, and
    54                                  ;       being outermost is still correct.
    55                                  ;
    56                                  ;  [V3] The 0xCC hole is this BIOS's *advertised* free-scratch pool: the APM
    57                                  ;       installer at E000:955B searches F000 for >=0x356 bytes of 0x0000 and
    58                                  ;       then of 0xCCCC. In the stock image its first search hits the zero run at
    59                                  ;       F000:F100 (0x741 bytes, boot block, which the flasher never erases), so
    60                                  ;       the 0xCC hole is not used today. To stay safe we emit ALL of our code
    61                                  ;       contiguously with no internal 0xCC gaps, so that if the allocator ever
    62                                  ;       falls through to the 0xCCCC search it lands on the untouched spare tail
    63                                  ;       (>= ~F000:0B00) and not on live code. Do not "pretty up" this file by
    64                                  ;       ALIGNing routines onto 0x80 boundaries with 0xCC fill.
    65                                  ;
    66                                  ;  [V4] Base-memory reservation must be gated on the RESERVATION STATE, not on
    67                                  ;       the presence of our signature. POST rebuilds 0040:0013 from scratch on
    68                                  ;       every boot (warm included: POST 1D writes it, POST 40 recreates the
    69                                  ;       EBDA), while the RAM contents at 0x9F80 survive a Ctrl-Alt-Del. A
    70                                  ;       signature-based idempotency check would therefore skip the decrement on
    71                                  ;       a warm boot and leave our live variables inside DOS-allocatable memory.
    72                                  ;       We test  ([0040:000E] - ([0040:0013] << 6)) :
    73                                  ;           == 0     -> not reserved yet, reserve now
    74                                  ;           == 0x40  -> already reserved (defensive; does not happen in stock)
    75                                  ;           else     -> unexpected layout, refuse to install
    76                                  ;
    77                                  ; ============================================================================
    78                                  
    79                                                  cpu     486
    80                                                  bits    16
    81                                                  org     0x0080                  ; F000:0080
    82                                  
    83                                  ; ---------------------------------------------------------------- constants
    84                                  SIG             equ     0x30313150              ; 'P110' little-endian
    85                                  
    86                                  OURDL_DEFAULT   equ     0x80                    ; BIOS drive number of the ATA
    87                                                                                  ; master at 0x1F0 (the PC110's
    88                                                                                  ; internal PC-Card ATA slot).
    89                                                                                  ; See README "OURDL".
    90                                  
    91                                  FALLBACK13_OFF  equ     0xD2D7                  ; boot-block base INT 13h handler
    92                                  FALLBACK13_SEG  equ     0xF000                  ; (never erased) - chain target of
    93                                                                                  ; last resort if our RAM block is gone
    94                                  
    95                                  FLG_PRESENT     equ     0x01
    96                                  FLG_LBA         equ     0x02
    97                                  FLG_XLAT        equ     0x04                    ; we own AH=02/03/04/08/15
    98                                  
    99                                  ; ------------------------------------------------- RAM block layout (1 KiB)
   100                                  ; Located at ([0040:000E] - 0x40) == 0x9F80 in the stock configuration.
   101                                  V_SIG           equ     0x000                   ; dd 'P110'
   102                                  V_OLD13         equ     0x004                   ; dd  displaced INT 13h vector
   103                                  V_OURDL         equ     0x008                   ; db  physical drive we own
   104                                  V_FLAGS         equ     0x009                   ; db  FLG_*
   105                                  V_TOTSEC        equ     0x00A                   ; dd  LBA28 sectors (clamped)
   106                                  V_C             equ     0x00E                   ; dw  reported cylinders
   107                                  V_H             equ     0x010                   ; dw  reported heads
   108                                  V_S             equ     0x012                   ; dw  reported sectors/track
   109                                  V_CHSTOT        equ     0x014                   ; dd  C*H*S
   110                                  V_IDW1          equ     0x018                   ; dw  IDENTIFY word 1
   111                                  V_IDW3          equ     0x01A                   ; dw  IDENTIFY word 3
   112                                  V_IDW6          equ     0x01C                   ; dw  IDENTIFY word 6
   113                                  V_IDW49         equ     0x01E                   ; dw  IDENTIFY word 49
   114                                  V_FDPT          equ     0x020                   ; 16  our fixed disk param table
   115                                  V_DPTE          equ     0x030                   ; 16  EDD 1.1 device param table ext
   116                                  V_LBA           equ     0x040                   ; dd  working LBA
   117                                  V_CNT           equ     0x044                   ; dw  sectors requested
   118                                  V_DONE          equ     0x046                   ; dw  sectors transferred
   119                                  V_BUFOFF        equ     0x048                   ; dw
   120                                  V_BUFSEG        equ     0x04A                   ; dw
   121                                  V_CMD           equ     0x04C                   ; db  0x20 read / 0x30 write
   122                                  V_ATAERR        equ     0x04D                   ; db  raw ATA error register
   123                                  V_SVSS          equ     0x04E                   ; dw  POST stack save
   124                                  V_SVSP          equ     0x050                   ; dw
   125                                  V_SCC           equ     0x052                   ; dw  stock-geometry cylinders
   126                                  V_SCH           equ     0x054                   ; dw  stock-geometry heads
   127                                  V_SCS           equ     0x056                   ; dw  stock-geometry sectors
   128                                  V_TMP           equ     0x058                   ; dw  scratch
   129                                  IDBUF           equ     0x100                   ; 512 IDENTIFY landing area
   130                                  STACKTOP        equ     0x400                   ; INIT-private stack 0x300..0x3FF
   131                                  
   132                                  ; ------------------------------------------------ INT 13h stack frame (BP)
   133                                  ; entry sequence: sub sp,4 / push bp / push ds / push es / pusha / mov bp,sp
   134                                  F_DI            equ     0
   135                                  F_SI            equ     2
   136                                  F_BP            equ     4
   137                                  F_SP            equ     6
   138                                  F_BX            equ     8
   139                                  F_DX            equ     10
   140                                  F_CX            equ     12
   141                                  F_AX            equ     14
   142                                  F_ES            equ     16
   143                                  F_DS            equ     18
   144                                  F_OBP           equ     20
   145                                  F_SC            equ     22                      ; 4-byte chain scratch
   146                                  F_IP            equ     26
   147                                  F_CS            equ     28
   148                                  F_FL            equ     30
   149                                  
   150                                  ; --------------------------------------------------------------- I/O macro
   151                                  ; Every ATA register write in this ROM is followed by `out 0x4F,al` as the
   152                                  ; I/O recovery delay (verified at F000:D674/D675, D6CB, D479, D488).
   153                                  %macro  ATAOUT 0
   154                                                  out     dx, al
   155                                                  out     0x4f, al
   156                                  %endmacro
   157                                  
   158                                  ; ============================================================================
   159                                  ;  INIT -- entered by the displaced JMP at F000:52BD (POST, SS=0000 SP=0400)
   160                                  ; ============================================================================
   161                                  INIT:
   162 00000000 60                                      pusha
   163 00000001 1E                                      push    ds
   164 00000002 06                                      push    es
   165 00000003 FC                                      cld
   166                                  
   167 00000004 31C0                                    xor     ax, ax
   168 00000006 8ED8                                    mov     ds, ax
   169 00000008 A10E04                                  mov     ax, [0x040E]            ; EBDA segment
   170 0000000B 85C0                                    test    ax, ax
   171 0000000D 0F848700                                jz      .out                    ; no EBDA -> refuse
   172 00000011 8B1E1304                                mov     bx, [0x0413]            ; conventional KB
   173 00000015 C1E306                                  shl     bx, 6                   ; top-of-memory segment
   174 00000018 89C2                                    mov     dx, ax
   175 0000001A 29DA                                    sub     dx, bx                  ; EBDA - top
   176 0000001C 7407                                    jz      .reserve                ; == 0 : not reserved yet   [V4]
   177 0000001E 83FA40                                  cmp     dx, 0x40
   178 00000021 7575                                    jne     .out                    ; unexpected layout -> refuse
   179 00000023 EB07                                    jmp     .initblk                ; already reserved, bx = block
   180                                  .reserve:
   181 00000025 FF0E1304                                dec     word [0x0413]           ; 639 -> 638
   182 00000029 83EB40                                  sub     bx, 0x40                ; block segment (0x9F80)
   183                                  .initblk:
   184 0000002C 8EC3                                    mov     es, bx
   185 0000002E 31FF                                    xor     di, di
   186 00000030 B90002                                  mov     cx, 512
   187 00000033 31C0                                    xor     ax, ax
   188 00000035 F3AB                                    rep     stosw                   ; wipe the whole 1 KiB
   189 00000037 2666C7060000503131-                     mov     dword [es:V_SIG], SIG
   189 00000040 30                 
   190                                  
   191                                                  ; ---- switch to a private stack ----------------------------
   192                                                  ; The POST stack is SS=0000 SP=0400, i.e. it grows down into
   193                                                  ; the top of the IVT. Keep our footprint out of it.
   194 00000041 8CD0                                    mov     ax, ss
   195 00000043 26A34E00                                mov     [es:V_SVSS], ax
   196 00000047 2689265000                              mov     [es:V_SVSP], sp
   197 0000004C FA                                      cli
   198 0000004D 8ED3                                    mov     ss, bx
   199 0000004F BC0004                                  mov     sp, STACKTOP
   200 00000052 FB                                      sti
   201                                  
   202 00000053 E88200                                  call    ATA_IDENT
   203 00000056 7208                                    jc      .restore
   204 00000058 E88001                                  call    GEOMCALC
   205 0000005B 7203                                    jc      .restore
   206 0000005D E84100                                  call    INSTALL
   207                                  .restore:
   208 00000060 26A15000                                mov     ax, [es:V_SVSP]
   209 00000064 FA                                      cli
   210 00000065 268E164E00                              mov     ss, [es:V_SVSS]
   211 0000006A 89C4                                    mov     sp, ax
   212 0000006C FB                                      sti
   213                                                  ; If we did not install (no card, no LBA support, POST saw no
   214                                                  ; drive) give the kilobyte back, so a card-less PC110 boots
   215                                                  ; byte-identically to stock with 639 KB, not 638 KB.
   216 0000006D 26F606090001                            test    byte [es:V_FLAGS], FLG_PRESENT
   217 00000073 7523                                    jnz     .out
   218 00000075 2666C7060000000000-                     mov     dword [es:V_SIG], 0
   218 0000007E 00                 
   219 0000007F 31C0                                    xor     ax, ax
   220 00000081 8ED8                                    mov     ds, ax
   221 00000083 8B1E1304                                mov     bx, [0x0413]
   222 00000087 C1E306                                  shl     bx, 6
   223 0000008A A10E04                                  mov     ax, [0x040E]
   224 0000008D 29D8                                    sub     ax, bx
   225 0000008F 83F840                                  cmp     ax, 0x40                ; is the KB really ours?
   226 00000092 7504                                    jne     .out
   227 00000094 FF061304                                inc     word [0x0413]
   228                                  .out:
   229 00000098 07                                      pop     es
   230 00000099 1F                                      pop     ds
   231 0000009A 61                                      popa
   232 0000009B FB                                      sti
   233 0000009C CD19                                    int     0x19                    ; displaced bootstrap call
   234 0000009E F4                                      hlt
   235 0000009F EBFD                                    jmp     short $-1
   236                                  
   237                                  ; ----------------------------------------------------------------- INSTALL
   238                                  ; ES = block. Takes over INT 13h and (in translate mode) INT 41h/46h.
   239                                  INSTALL:
   240 000000A1 31C0                                    xor     ax, ax
   241 000000A3 8ED8                                    mov     ds, ax
   242 000000A5 FA                                      cli
   243 000000A6 66A14C00                                mov     eax, [0x004C]           ; whatever is outermost now
   244 000000AA 2666A30400                              mov     [es:V_OLD13], eax       ; (F000:952A on a stock cold boot)
   245 000000AF C7064C00[6003]                          mov     word [0x004C], OURINT13
   246 000000B5 8C0E4E00                                mov     [0x004E], cs            ; = F000
   247 000000B9 26F606090004                            test    byte [es:V_FLAGS], FLG_XLAT
   248 000000BF 7415                                    jz      .nofdpt
   249 000000C1 BF0401                                  mov     di, 0x0104              ; INT 41h  = drive 0x80 FDPT
   250 000000C4 26803E080080                            cmp     byte [es:V_OURDL], 0x80
   251 000000CA 7403                                    je      .setfdpt
   252 000000CC BF1801                                  mov     di, 0x0118              ; INT 46h  = drive 0x81 FDPT
   253                                  .setfdpt:
   254 000000CF C7052000                                mov     word [di], V_FDPT
   255 000000D3 8C4502                                  mov     [di+2], es
   256                                  .nofdpt:
   257 000000D6 FB                                      sti
   258 000000D7 C3                                      ret
   259                                  
   260                                  ; ============================================================================
   261                                  ;  ATA_IDENT -- one bounded IDENTIFY DEVICE at POST time.  ES = block.
   262                                  ;  CF=1 on any failure (no card, floating bus, ATAPI, timeout, zero capacity).
   263                                  ; ============================================================================
   264                                  ATA_IDENT:
   265 000000D8 BAF603                                  mov     dx, 0x3F6               ; device control: nIEN=1, SRST=0
   266 000000DB B00A                                    mov     al, 0x0A
   267                                                  ATAOUT
   154 000000DD EE                  <1>  out dx, al
   155 000000DE E64F                <1>  out 0x4f, al
   268 000000E0 BAF601                                  mov     dx, 0x1F6               ; select master, CHS bit pattern
   269 000000E3 B0A0                                    mov     al, 0xA0
   270                                                  ATAOUT
   154 000000E5 EE                  <1>  out dx, al
   155 000000E6 E64F                <1>  out 0x4f, al
   271 000000E8 B90A00                                  mov     cx, 10                  ; settle (as E000:C66F does)
   272 000000EB E2FE                    .settle:        loop    .settle
   273                                  
   274                                                  ; ---- presence sniff: costs nothing on a card-less machine --
   275 000000ED BAF701                                  mov     dx, 0x1F7
   276 000000F0 EC                                      in      al, dx
   277 000000F1 3CFF                                    cmp     al, 0xFF                ; floating bus / window down
   278 000000F3 0F848E00                                je      .fail
   279 000000F7 84C0                                    test    al, al                  ; nothing there
   280 000000F9 0F848800                                jz      .fail
   281                                  
   282 000000FD E88700                                  call    WAIT_NOT_BSY
   283 00000100 0F828100                                jc      .fail
   284                                  
   285 00000104 30C0                                    xor     al, al                  ; clear the task file
   286 00000106 BAF101                                  mov     dx, 0x1F1
   287                                                  ATAOUT
   154 00000109 EE                  <1>  out dx, al
   155 0000010A E64F                <1>  out 0x4f, al
   288 0000010C 42                                      inc     dx                      ; 1F2 sector count
   289                                                  ATAOUT
   154 0000010D EE                  <1>  out dx, al
   155 0000010E E64F                <1>  out 0x4f, al
   290 00000110 42                                      inc     dx                      ; 1F3
   291                                                  ATAOUT
   154 00000111 EE                  <1>  out dx, al
   155 00000112 E64F                <1>  out 0x4f, al
   292 00000114 42                                      inc     dx                      ; 1F4
   293                                                  ATAOUT
   154 00000115 EE                  <1>  out dx, al
   155 00000116 E64F                <1>  out 0x4f, al
   294 00000118 42                                      inc     dx                      ; 1F5
   295                                                  ATAOUT
   154 00000119 EE                  <1>  out dx, al
   155 0000011A E64F                <1>  out 0x4f, al
   296 0000011C 42                                      inc     dx                      ; 1F6 device/head
   297 0000011D B0A0                                    mov     al, 0xA0
   298                                                  ATAOUT
   154 0000011F EE                  <1>  out dx, al
   155 00000120 E64F                <1>  out 0x4f, al
   299 00000122 42                                      inc     dx                      ; 1F7 command
   300 00000123 B0EC                                    mov     al, 0xEC                ; IDENTIFY DEVICE
   301                                                  ATAOUT
   154 00000125 EE                  <1>  out dx, al
   155 00000126 E64F                <1>  out 0x4f, al
   302                                  
   303 00000128 E88200                                  call    WAIT_DRQ                ; ATAPI answers with ERR -> CF=1
   304 0000012B 7258                                    jc      .fail
   305                                  
   306 0000012D BF0001                                  mov     di, IDBUF
   307 00000130 BAF001                                  mov     dx, 0x1F0
   308 00000133 B90001                                  mov     cx, 256
   309 00000136 FC                                      cld
   310 00000137 F36D                                    rep     insw                    ; -> ES:DI
   311 00000139 BAF603                                  mov     dx, 0x3F6
   312 0000013C EC                                      in      al, dx                  ; settle
   313                                  
   314                                                  ; ---- extract the words we keep ----------------------------
   315 0000013D 26A10001                                mov     ax, [es:IDBUF + 0*2]
   316 00000141 F6C480                                  test    ah, 0x80                ; bit 15 set -> not ATA
   317 00000144 753F                                    jnz     .fail
   318 00000146 26A10201                                mov     ax, [es:IDBUF + 1*2]
   319 0000014A 26A31800                                mov     [es:V_IDW1], ax
   320 0000014E 26A10601                                mov     ax, [es:IDBUF + 3*2]
   321 00000152 26A31A00                                mov     [es:V_IDW3], ax
   322 00000156 26A10C01                                mov     ax, [es:IDBUF + 6*2]
   323 0000015A 26A31C00                                mov     [es:V_IDW6], ax
   324 0000015E 26A16201                                mov     ax, [es:IDBUF + 49*2]
   325 00000162 26A31E00                                mov     [es:V_IDW49], ax
   326                                  
   327 00000166 2666A17801                              mov     eax, [es:IDBUF + 60*2]  ; words 60..61 = LBA28 sectors
   328 0000016B 6685C0                                  test    eax, eax
   329 0000016E 7415                                    jz      .fail
   330 00000170 663DFFFFFF0F                            cmp     eax, 0x0FFFFFFF         ; clamp so bits 28..31 are always 0
   331 00000176 7606                                    jbe     .store
   332 00000178 66B8FFFFFF0F                            mov     eax, 0x0FFFFFFF
   333                                  .store:
   334 0000017E 2666A30A00                              mov     [es:V_TOTSEC], eax
   335 00000183 F8                                      clc
   336 00000184 C3                                      ret
   337                                  .fail:
   338 00000185 F9                                      stc
   339 00000186 C3                                      ret
   340                                  
   341                                  ; ============================================================================
   342                                  ;  WAIT_NOT_BSY / WAIT_DRQ
   343                                  ;  Timing comes from the ISA refresh bit (port 0x61 bit 4, toggles every
   344                                  ;  15.085 us) exactly as the stock boot-block loop at F000:D92B does, so the
   345                                  ;  timeout is independent of CPU clock, cache and emulation speed.
   346                                  ;  0x8C outer * 0x40 refresh transitions ~= 2 s.
   347                                  ;  Clobbers AX, CX, DX.  CF=1 on timeout / error.
   348                                  ; ============================================================================
   349                                  WAIT_NOT_BSY:
   350 00000187 53                                      push    bx
   351 00000188 BAF701                                  mov     dx, 0x1F7
   352 0000018B B78C                                    mov     bh, 0x8C
   353 0000018D B94000                  .outer:         mov     cx, 0x40
   354 00000190 30E4                                    xor     ah, ah
   355 00000192 EC                      .poll:          in      al, dx
   356 00000193 A880                                    test    al, 0x80                ; BSY
   357 00000195 7413                                    jz      .ok
   358 00000197 E461                                    in      al, 0x61
   359 00000199 2410                                    and     al, 0x10
   360 0000019B 38E0                                    cmp     al, ah
   361 0000019D 74F3                                    je      .poll                   ; refresh bit unchanged
   362 0000019F 88C4                                    mov     ah, al
   363 000001A1 E2EF                                    loop    .poll
   364 000001A3 FECF                                    dec     bh
   365 000001A5 75E6                                    jnz     .outer
   366 000001A7 5B                                      pop     bx
   367 000001A8 F9                                      stc
   368 000001A9 C3                                      ret
   369 000001AA 5B                      .ok:            pop     bx
   370 000001AB F8                                      clc
   371 000001AC C3                                      ret
   372                                  
   373                                  WAIT_DRQ:
   374 000001AD 53                                      push    bx
   375 000001AE BAF701                                  mov     dx, 0x1F7
   376 000001B1 B78C                                    mov     bh, 0x8C
   377 000001B3 B94000                  .outer:         mov     cx, 0x40
   378 000001B6 30E4                                    xor     ah, ah
   379 000001B8 EC                      .poll:          in      al, dx
   380 000001B9 A880                                    test    al, 0x80                ; BSY set -> keep waiting
   381 000001BB 7508                                    jnz     .tick
   382 000001BD A821                                    test    al, 0x21                ; ERR | DF -> fail fast
   383 000001BF 7514                                    jnz     .err
   384 000001C1 A808                                    test    al, 0x08                ; DRQ
   385 000001C3 7513                                    jnz     .ok
   386 000001C5 E461                    .tick:          in      al, 0x61
   387 000001C7 2410                                    and     al, 0x10
   388 000001C9 38E0                                    cmp     al, ah
   389 000001CB 74EB                                    je      .poll
   390 000001CD 88C4                                    mov     ah, al
   391 000001CF E2E7                                    loop    .poll
   392 000001D1 FECF                                    dec     bh
   393 000001D3 75DE                                    jnz     .outer
   394 000001D5 5B                      .err:           pop     bx
   395 000001D6 F9                                      stc
   396 000001D7 C3                                      ret
