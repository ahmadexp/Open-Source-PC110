   612                                  ; ------------------------------------------------------------------ CHAIN
   613                                  ; True tail transfer: every register and every flag exactly as at entry.
   614                                  ; The saved vector lives in RAM so `jmp far [cs:..]` is impossible; we use the
   615                                  ; frame-rewrite + RETF idiom the stock shim at F000:BB59 uses.
   616                                  ; The 4-byte scratch we reserved with `sub sp,4` is what RETF consumes, so the
   617                                  ; caller's IP/CS/FLAGS frame reaches the downstream handler untouched.
   618                                  CHAIN:                                          ; ES = block
   619 000003F2 26A10400                                mov     ax, [es:V_OLD13]
